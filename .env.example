# =================================================================
# REFLECTION AI ASSESSMENT SYSTEM - ENVIRONMENT TEMPLATE
# Copy to .env (and .env.local in portal folders) with real values.
# NEVER commit actual secrets to version control.
# =================================================================

# --- Supabase Authoritative Configuration ---
# Public URL and Anon Key (safe for browser client-side in Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER expose to browser)
# Used exclusively by Professor Portal API (/api/students/provision) and Backend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# Direct PostgreSQL Connection String (for CLI migrations if needed)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# --- Backend Assessment & Extraction Service (FastAPI) ---
FASTAPI_BACKEND_URL=http://localhost:8000
INTERNAL_API_SECRET_KEY=generate-a-secure-random-token-for-internal-calls
MIN_SIMILARITY_THRESHOLD=0.35
MAX_REFLECTION_CHARACTERS=500

# --- Future RAVEN Integration Layer ---
RAVEN_INTEGRATION_ENABLED=false
RAVEN_WORKER_URL=http://127.0.0.1:8010
RAVEN_WORKER_SECRET_KEY=raven-local-worker-secret-placeholder
RAVEN_TIMEOUT_SECONDS=15
